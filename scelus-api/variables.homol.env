# =============================================================================
# Scelus — Variáveis de Ambiente (HOMOL)
# Copie/renomeie para variables.env no servidor de homologação.
# Este arquivo NÃO deve conter senhas reais — use-o apenas como template.
# =============================================================================

# Banco de Dados PostgreSQL (dba_scelus)
SPRING_DATASOURCE_POSTGRES_URL=jdbc:postgresql://<host_banco_postgres_homol>:5432/dba_scelus
SPRING_DATASOURCE_POSTGRES_USERNAME=dba_scelus
POSTGRES_DB_PASSWORD=<senha_postgres_homol>

# Banco de Dados Sentinela (Oracle)
SPRING_DATASOURCE_SENTINELA_URL=jdbc:oracle:thin:@//<host_banco_sentinela_homol>:1521/pjma
SPRING_DATASOURCE_SENTINELA_USERNAME=dba_sentinela
SENTINELA_DB_PASSWORD=<senha_sentinela_homol>

# Ambiente Spring Boot
SPRING_PROFILES_ACTIVE=homolog
TJMA_AMBIENTE=HOMOLOGACAO

# URL do Sentinela (HOMOL)
TJMA_SENTINELA_URL=https://sistemash.tjma.jus.br/sentinela/
SENTINELA_FRONTEND_URL=https://sistemash.tjma.jus.br/scelus/
