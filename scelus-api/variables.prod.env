# =============================================================================
# Scelus — Variáveis de Ambiente (PROD)
# Copie/renomeie para variables.env no servidor de produção.
# Este arquivo NÃO deve conter senhas reais — use-o apenas como template.
# =============================================================================

# Banco de Dados PostgreSQL (dba_scelus)
SPRING_DATASOURCE_POSTGRES_URL=jdbc:postgresql://<host_banco_postgres_prod>:5432/dba_scelus
SPRING_DATASOURCE_POSTGRES_USERNAME=dba_scelus
POSTGRES_DB_PASSWORD=<senha_postgres_prod>

# Banco de Dados Sentinela (Oracle)
SPRING_DATASOURCE_SENTINELA_URL=jdbc:oracle:thin:@//<host_banco_sentinela_prod>:1521/pjma
SPRING_DATASOURCE_SENTINELA_USERNAME=dba_sentinela
SENTINELA_DB_PASSWORD=<senha_sentinela_prod>

# Ambiente Spring Boot
SPRING_PROFILES_ACTIVE=prod
TJMA_AMBIENTE=PRODUCAO

# URL do Sentinela (PROD)
TJMA_SENTINELA_URL=https://sistemas.tjma.jus.br/sentinela/
SENTINELA_FRONTEND_URL=https://sistemas.tjma.jus.br/scelus/
