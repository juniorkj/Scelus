# =============================================================================
# Scelus — Variáveis de Ambiente (DEV)
# Copie/renomeie para variables.env no servidor e preencha as senhas reais.
# Este arquivo NÃO deve conter senhas reais — use-o apenas como template.
# =============================================================================

# Banco de Dados PostgreSQL (dba_scelus)
POSTGRES_DB_PASSWORD=dba_scelus

# Banco de Dados Sentinela
SENTINELA_DB_PASSWORD=dba_sentinela

# Ambiente Spring Boot
SPRING_PROFILES_ACTIVE=desenv
TJMA_AMBIENTE=DESENV

# URL do Sentinela (DEV)
TJMA_SENTINELA_URL=https://sistemasd.tjma.jus.br/sentinela
